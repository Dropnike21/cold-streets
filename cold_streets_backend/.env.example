# Cold Streets — private Node.js API configuration
# Copy to .env in a private deployment environment. NEVER commit .env.
# The API fails closed (503) when Supabase Auth is not configured.

PORT=3000
NODE_ENV=production

# Keep ALL gameplay routes (including /auth/session) closed until a
# staging review authorizes authenticated gameplay requests.
ENABLE_GAMEPLAY_API=false
# ENABLE_UNSAFE_LEGACY_TIMERS is permanently retired. Do not set it.

# The SAME Supabase project that hosts the PostgreSQL game tables.
# Only HTTPS is accepted by the session-verification middleware.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key is not a secret, but DO NOT use the service_role or sb_secret_ key.
# Server uses this key ONLY to call GET /auth/v1/user to verify access tokens.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_KEY

# Only origins explicitly listed below may call the API from a browser.
# Native Flutter clients generally send no Origin header.
# Add production web origins only after they have been deployed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:3000

# PostgreSQL direct or Supabase connection-pooler credentials.
# These MUST remain server-only. Do not include them in Flutter or GitHub.
DB_HOST=YOUR_SESSION_POOLER_HOST_FROM_SUPABASE_CONNECT_DIALOG
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
DB_SSL=true
# Use Supabase's shared session pooler (port 5432) for IPv4-only
# persistent Node hosts. Transaction-pooling port 6543 has different
# session-state constraints. Copy the HOST from the Connect dialog;
# do not derive or guess it from your region.
