<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, provide hot reload, and call the local
         Cold Streets Node API from an Android emulator.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds may call the laptop-hosted API at http://10.0.2.2:3000.
         Production/profile builds must continue to use HTTPS. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
